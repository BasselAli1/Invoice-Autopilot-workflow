      "name": "Extract info from PDF"
    },
    {
      "parameters": {
        "jsCode": "const inv = $input.first().json.output\nconst items = inv.line_items || []\n\nconst itemsSum = items.reduce((sum, i) => sum + i.quantity * i.unit_price, 0)\nconst expectedTotal = inv.subtotal + inv.tax\n\nconst itemsMatchSubtotal = Math.abs(itemsSum - inv.subtotal) < 0.02\nconst totalMatches = Math.abs(expectedTotal - inv.total) < 0.02\nconst hasRequiredFields = Boolean(inv.vendor && inv.invoice_number && inv.date && inv.total)\nconst confident = inv.confidence >= 0.8\n\nconst needs_review = !(itemsMatchSubtotal && totalMatches && hasRequiredFields && confident)\n\nreturn [{\n  json: {\n    ...inv,\n    checks: { itemsMatchSubtotal, totalMatches, hasRequiredFields, confident },\n    needs_review\n  }\n}]"
      },
